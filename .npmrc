# onnxruntime-node (used by @huggingface/transformers for /api/meaning-search, Cowork ENTRY 390 GO): never download its
# optional CUDA/TensorRT libraries at install. On linux/x64 (Vercel builds) it otherwise fetches about 236 MB compressed
# from NuGet and the function goes over the 250 MB limit. npm passes this to the package's postinstall as
# npm_config_onnxruntime_node_install=skip (onnxruntime-node script/install-utils.js parseInstallFlag).
onnxruntime-node-install=skip
