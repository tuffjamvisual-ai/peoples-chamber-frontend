html,
body {
  margin: 0;
  padding: 0;
  min-height: 100%;
  background: #7a1612;
}

.home-stage {
  min-height: 100vh;
  display: grid;
  place-items: start center;
  padding: 24px 16px 48px;
  background: #7a1612;
}

.home-shell {
  position: relative;
  width: 100%;
  max-width: 1086px;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
}

.home-shell img {
  display: block;
  width: 100%;
  height: auto;
}

.home-shell a.hot {
  position: absolute;
  display: block;
  /* Uncomment to debug placement:
  background: rgba(0, 255, 0, 0.22); outline: 1px dashed lime; */
  cursor: pointer;
}

.home-shell a.hot:focus-visible {
  outline: 2px solid #1c4c78;
  outline-offset: -2px;
}

/* ───── Top stamps (small click targets) ───── */
.hot.h-issue { top: 1%;   left: 1%;  width: 14%; height: 5%; }
.hot.h-truth { top: 1.5%; left: 74%; width: 20%; height: 6%; }

/* ───── Masthead (logo only) ───── */
.hot.h-masthead { top: 3%; left: 10%; width: 62%; height: 13%; }

/* ───── Nav strip (re-measured from home.png 1086×1448 nav text bounds) ─────
 * Each hotspot wraps its painted text with ~1% horizontal padding.
 * DEPARTMENTS in particular was 4% too far left and 4% too narrow.
 * Vertical band (top 19.5% + height 3%) was already correct.
 */
.hot.n-home   { top: 19.5%; left: 5%;    width: 7%;    height: 3%; z-index: 5; }
.hot.n-bills  { top: 19.5%; left: 14%;   width: 7.5%;  height: 3%; z-index: 5; }
.hot.n-laws   { top: 19.5%; left: 25%;   width: 6%;    height: 3%; z-index: 5; }
.hot.n-polls  { top: 19.5%; left: 34%;   width: 15%;   height: 3%; z-index: 5; }
.hot.n-mps    { top: 19.5%; left: 52.5%; width: 6.5%;  height: 3%; z-index: 5; }
.hot.n-depts  { top: 19.5%; left: 62.5%; width: 17%;   height: 3%; z-index: 5; }
.hot.n-login  { top: 19.5%; left: 82%;   width: 7.5%;  height: 3%; z-index: 5; }
.hot.n-about  { top: 19.5%; left: 92%;   width: 7%;    height: 3%; z-index: 5; }

/* ───── Hero CTAs (buttons only) ───── */
.hot.hero-explore { top: 35%; left: 4%;  width: 19%; height: 3%; }
.hot.hero-money   { top: 35%; left: 25%; width: 19%; height: 3%; }

/* ───── Cover Story "Read the story →" link only ───── */
.hot.cover-cta { top: 57%; left: 4%; width: 16%; height: 2.5%; }

/* ───── Bills to Watch rows + See all bills ───── */
.hot.bills-row-1 { top: 44%;   left: 65%; width: 31%; height: 3%; }
.hot.bills-row-2 { top: 47.5%; left: 65%; width: 31%; height: 3%; }
.hot.bills-row-3 { top: 51%;   left: 65%; width: 31%; height: 3%; }
.hot.bills-row-4 { top: 54.5%; left: 65%; width: 31%; height: 3%; }
.hot.bills-row-5 { top: 58%;   left: 65%; width: 31%; height: 3%; }
.hot.bills-all   { top: 62%;   left: 85%; width: 12%; height: 2.5%; }

/* ───── Take Part poll (small CTA) ───── */
.hot.poll { top: 78%; left: 80%; width: 18%; height: 9%; }

/* ───── Footer link columns (narrow) ───── */
.hot.f-col-1 { top: 89%; left: 41%; width: 11%; height: 7%; }
.hot.f-col-2 { top: 89%; left: 53%; width: 11%; height: 7%; }
.hot.f-col-3 { top: 89%; left: 65%; width: 18%; height: 7%; }
.hot.f-col-4 { top: 89%; left: 84%; width: 14%; height: 7%; }
