# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
app/page.tsx.bak.gray-design
app/bills/page.tsx.bak.gray
public/pca-art.webp.bak
public/bill-parchment.webp.bak
public/bill-parchment.webp.prev
public/bill-parchment.webp.prev2
.env*.local

# Scottish Water overflow workbooks, downloaded by hand for scripts/import-sewage-scotland.js
data/sewage-scotland/

# Saved CQC council assessment results (scripts/import-council-ratings.js --with-cqc)
data/council-ratings/

# Outgoing emails and send records for scripts/mail (private correspondence)
scripts/mail/outbox/
scripts/mail/sent-log/
scripts/mail/pending-replies.md

# Working files for the lobbying index hand review (scripts/build-lobbying-index.js)
data/lobbying/

# Registrar of Consultant Lobbyists files, downloaded by hand (scripts/import-orcl-returns.js); the manifest is kept
data/orcl/*
!data/orcl/manifest.csv

# Open Council Data UK compositions file, downloaded by hand (scripts/import-council-composition.js)
data/opencouncildata/

# IPSA files downloaded by hand in a browser (theipsa.org.uk robots.txt disallows /api/*)
data/ipsa/

# temporary key hand-off file (never commit)
paste-key-here.txt

# Claude prompts and reports (never commit)
Claude outputs/

# Private: outreach notes for scripts/mail (names, past contact); outbox and sent-log are already ignored
scripts/mail/*.md
# Working output at the repo root only (build, dry run and import logs; data exports); never matches subfolders
/*.txt
/*.jsonl
/*.csv
# Root working JSON and review notes, by name (so a new config .json or doc .md at the root is not hidden)
/batch1.json
/batch1-current-bios.json
/opinion-pilot-input.json
/opinion_pilot_edits.json
/bio-bulk-fixes-review.md
/bio-commentary-sample.md
/opinion-pilot-review.md
/template-and-roles-review.md
# Previews and audits written by scripts (the tracked lookups in scripts/data stay tracked)
scripts/data/*-preview.csv
scripts/data/hyphen-audit-*.csv
scripts/data/source-shortening-flagged.csv
# LGSCO files downloaded by hand (the tracked copy is scripts/data/lgsco/)
data/lgsco/

# Next.js dev notice, rewritten by next dev
/AGENTS.md
